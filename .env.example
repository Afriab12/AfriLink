# Local development only — copy to .env and adjust if needed.
# Never commit .env (already gitignored) or any real credential.
POSTGRES_DB=afrilink_dev
POSTGRES_USER=afrilink
POSTGRES_PASSWORD=replace_with_a_local_dev_password
POSTGRES_PORT=5432

# Local MinIO (S3-compatible object storage), dev/test only — docs/05-api/media.md §11.
MINIO_ROOT_USER=afrilink
MINIO_ROOT_PASSWORD=replace_with_a_local_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MEDIA_BUCKET_NAME=afrilink-media-dev
MEDIA_TEST_BUCKET_NAME=afrilink-media-test
