// AfriLink database schema — Phase 1 + Database Phase 2 (Communities,
// Messaging, Notifications)
//
// Phase 1 scope: identity, reference, social, content, integration
// (docs/04-database/database.md §25, step 2).
// Database Phase 2 scope (in progress): `community` (§8), `messaging`
// (§9), `notification` (§10). Media, moderation, audit, feed, and search
// are still NOT modeled here yet — added incrementally, one module at a
// time, in later phases.
//
// Design source of truth: docs/04-database/database.md
// Approved decisions: docs/10-decisions/decisions.md (ADR-001, ADR-003),
// docs/03-architecture/approval-gate.md (ADR-002)
//
// Deliberate Phase 1 omissions (see database.md for each):
// - `content.posts.reply_to_post_id` — threaded posts are not an approved
//   product decision (database.md §6: "only if threaded posts are approved").
// - `content.post_media` / `content.comment_media` — depend on the `media`
//   schema, which is not part of Phase 1 or this Communities increment.
// - `content.visibility_rules` — exception-list table, not needed until a
//   visibility exception actually arises (database.md §6).
// - `social.profiles.avatar_media_id` is a plain nullable UUID column with
//   NO foreign key yet, because the `media` schema doesn't exist yet. Same
//   treatment now applied to `community.communities.avatar_media_id` /
//   `cover_media_id` below. `content.posts.community_id` DOES now get its
//   foreign key, added in this increment (see Post.community below) — the
//   `community` schema it pointed at now exists.
//
// Deliberate Communities-increment omission:
// - `community.moderator_assignments` — database.md §8 frames this as
//   conditional ("if community roles require more detail than membership
//   roles"). `CommunityMembership.role` already gives an open, app-validated
//   slot for "moderator", and nothing approved yet requires finer-grained
//   scoped grants — same reasoning already applied to deferring
//   `content.visibility_rules` in Phase 1. Added later if/when that need
//   is concretely approved.
//
// Deliberate Messaging-increment omissions:
// - `messaging.message_receipts` — database.md §9 itself frames per-message
//   delivered/read receipts as conditional ("use conversation-level read
//   cursors for scale, with per-message receipts only if required by
//   product behavior"). `Participant.lastReadMessageId` already gives the
//   preferred cursor-based read state; "delivered" is closer to the
//   ephemeral, connection-level facts architecture.md §14/§24 says belong
//   in Redis (presence/typing), not durable Postgres rows. Added later if
//   per-message granularity is concretely approved.
// - Message image attachments — PRD §19/architecture.md §14 approve them
//   as MVP scope, but implementing them depends on the `media` schema,
//   which doesn't exist yet — identical blocker to, and given the exact
//   same full-deferral treatment as, `content.post_media` above. No
//   column or table added; revisit alongside the `media` phase.
// - A separate `message_requests` table — architecture.md §14 explicitly
//   rules this out: "Message requests are a conversation/message state
//   (pending vs. accepted), not a separate data model." Represented via
//   `Conversation.status` instead (see that field's comment below).
// - Reporting relationships (`report → message/conversation`) — the
//   `moderation` schema they'd reference doesn't exist yet (out of scope
//   for this increment). `Conversation`/`Message` already use the same
//   UUID `id` scheme as everything else, so `moderation.reports` can
//   reference them generically (e.g. target_type/target_id, matching
//   `notification.notifications`' existing pattern) once Moderation is
//   implemented — no schema change needed now.
// - A messaging-specific block table — `social.blocks` (Phase 1) already
//   represents every block relationship app-wide; messaging enforces it
//   at the application layer (out of scope here) rather than duplicating
//   the relationship in a new table, per this turn's explicit instruction
//   not to redesign `social.blocks`.
//
// Deliberate Notifications-increment omissions and decisions:
// - `notification.deliveries` — database.md §10 designs it for push/email/
//   SMS provider attempts (retry, provider message IDs, reconciliation).
//   Those channels are still an open product/vendor decision
//   (approval-gate.md: "whether push/email/SMS ship at MVP versus in-app
//   only"), and MVP in-app notifications are plain REST-polled rows
//   (ADR-004 §7) with no provider attempt to record. Nothing to attach
//   delivery rows to yet — added when a channel is actually approved.
// - No notification-type/category vocabulary is defined here. Neither
//   database.md §10, PRD §20, nor any ADR enumerates one (PRD only names
//   broad areas: relationships, posts, comments, reactions, shares,
//   community events, messages, verification, moderation outcomes), so
//   `type`/`category` stay app-validated strings — same treatment as
//   `content.posts.visibility` — rather than inventing a closed set.
// - No notification retention period is defined here. No approved
//   document sets one (ADR-001/ADR-003 cover content, messages, accounts;
//   architecture.md treats notifications as derived/rebuildable). The
//   schema only supplies the lifecycle hooks (`deleted_at`, indexed) a
//   future retention job needs; the window itself is an open decision.
// - Message/post/comment/etc. targets are referenced polymorphically via
//   `target_type`/`target_id` with NO foreign key, as database.md §10
//   designs it — a notification must survive (and re-resolve visibility
//   against) its target, and notification payloads never carry message
//   bodies.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Connection URL moved to prisma7.config.ts (Prisma 7 no longer accepts
  // `url` directly in schema.prisma — see database/prisma7.config.ts).
  schemas    = ["identity", "reference", "social", "content", "community", "messaging", "notification", "integration"]
  extensions = [citext]
}

// ============================================================
// identity schema — docs/04-database/database.md §4
// ============================================================

enum UserStatus {
  active
  restricted
  suspended
  banned
  pending_deletion
  deleted

  @@schema("identity")
}

enum AccountType {
  individual
  creator
  business
  organization

  @@schema("identity")
}

model User {
  id          String      @id @default(uuid(7)) @db.Uuid
  handle      String?     @unique @db.Citext
  status      UserStatus  @default(active)
  accountType AccountType @default(individual) @map("account_type")
  locale      String      @default("en")
  timezone    String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  credentials            Credential[]
  sessions               Session[]
  verificationChallenges VerificationChallenge[]
  userRoles              UserRole[]
  profile                Profile?
  userInterests          UserInterest[]
  followsAsFollower      Follow[]          @relation("FollowerFollows")
  followsAsFollowee      Follow[]          @relation("FolloweeFollows")
  friendshipsRequested   Friendship[]      @relation("FriendshipRequester")
  friendshipsReceived    Friendship[]      @relation("FriendshipAddressee")
  blocksAsBlocker        Block[]           @relation("BlockerBlocks")
  blocksAsBlocked        Block[]           @relation("BlockedByBlocks")
  preferences            UserPreference?
  posts                  Post[]
  comments               Comment[]
  postReactions          PostReaction[]
  commentReactions       CommentReaction[]
  shares                 Share[]
  ownedCommunities              Community[]           @relation("CommunityOwner")
  communityMemberships          CommunityMembership[]
  sentCommunityInvitations      CommunityInvitation[]  @relation("CommunityInvitationInviter")
  receivedCommunityInvitations  CommunityInvitation[]  @relation("CommunityInvitationInvitee")
  createdConversations          Conversation[]         @relation("ConversationCreator")
  directConversationsAsA        Conversation[]         @relation("ConversationDirectParticipantA")
  directConversationsAsB        Conversation[]         @relation("ConversationDirectParticipantB")
  conversationParticipations    Participant[]
  sentMessages                  Message[]              @relation("MessageSender")
  receivedNotifications         Notification[]         @relation("NotificationRecipient")
  triggeredNotifications        Notification[]         @relation("NotificationActor")
  notificationPreferences       NotificationPreference[]

  @@index([status, createdAt])
  @@index([deletedAt]) // deleted-at lifecycle queries, per database.md §4
  @@map("users")
  @@schema("identity")
}

model Credential {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  kind                 String
  identifierNormalized String    @map("identifier_normalized")
  secretHash           String    @map("secret_hash")
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uniqueness on (kind, identifier_normalized) is enforced only among
  // ACTIVE (revoked_at IS NULL) credentials via a partial index added in
  // the migration SQL — Prisma's @@unique cannot express a WHERE clause.
  @@index([userId])
  @@map("credentials")
  @@schema("identity")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  deviceLabel      String?   @map("device_label")
  ipHash           String?   @map("ip_hash")
  userAgentHash    String?   @map("user_agent_hash")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason     String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
  @@schema("identity")
}

model VerificationChallenge {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  channel         String
  destinationHash String    @map("destination_hash")
  purpose         String
  challengeHash   String    @map("challenge_hash")
  attemptCount    Int       @default(0) @map("attempt_count")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destinationHash, purpose, expiresAt])
  @@map("verification_challenges")
  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
  @@schema("identity")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

model UserRole {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  scopeType  String?   @map("scope_type")
  scopeId    String?   @map("scope_id") @db.Uuid
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Uniqueness of (user_id, role_id, scope_type, scope_id) among ACTIVE
  // (revoked_at IS NULL) assignments is a partial index in the migration.
  @@index([userId])
  @@map("user_roles")
  @@schema("identity")
}

// ============================================================
// reference schema — docs/04-database/database.md §5
// Seed content approved in ADR-003 §7
// ============================================================

model Country {
  code      String   @id @db.Char(2)
  name      String
  nameLocal String?  @map("name_local")
  region    String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  profiles Profile[]

  @@map("countries")
  @@schema("reference")
}

model Interest {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  label     String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userInterests UserInterest[]

  @@map("interests")
  @@schema("reference")
}

// ============================================================
// social schema — docs/04-database/database.md §5
// ============================================================

enum ProfileVisibility {
  public
  followers
  private

  @@schema("social")
}

model Profile {
  userId              String            @id @map("user_id") @db.Uuid
  displayName         String?           @map("display_name")
  bio                 String?
  avatarMediaId       String?           @map("avatar_media_id") @db.Uuid // FK to media.assets added when `media` schema exists (later phase)
  countryCode         String?           @map("country_code") @db.Char(2)
  region              String?
  websiteUrl          String?           @map("website_url")
  visibility          ProfileVisibility @default(public)
  primaryLanguage     String            @default("en") @map("primary_language") // English-only for MVP per ADR-003 §7; no reference.languages table yet
  profileMetadata     Json?             @map("profile_metadata")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country? @relation(fields: [countryCode], references: [code])

  @@index([countryCode])
  @@map("profiles")
  @@schema("social")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId, userId])
  @@map("user_interests")
  @@schema("social")
}

enum FollowStatus {
  active // single value for Phase 1; deletedAt handles removal.
         // `status` kept per database.md §5 as a placeholder for a future
         // distinction (e.g. muted-but-following) — not a current need.

  @@schema("social")
}

model Follow {
  id         String       @id @default(uuid(7)) @db.Uuid
  followerId String       @map("follower_id") @db.Uuid
  followeeId String       @map("followee_id") @db.Uuid
  status     FollowStatus @default(active)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz

  follower User @relation("FollowerFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FolloweeFollows", fields: [followeeId], references: [id], onDelete: Cascade)

  // Self-follow CHECK and the partial-unique "one active pair" index are
  // added in the migration SQL (not expressible in Prisma's schema DSL).
  @@index([followeeId, createdAt, followerId])
  @@index([followerId, createdAt, followeeId])
  @@map("follows")
  @@schema("social")
}

enum FriendshipStatus {
  pending
  accepted
  declined
  removed

  @@schema("social")
}

model Friendship {
  id           String           @id @default(uuid(7)) @db.Uuid
  requesterId  String           @map("requester_id") @db.Uuid
  addresseeId  String           @map("addressee_id") @db.Uuid
  status       FriendshipStatus @default(pending)
  requestedAt  DateTime         @default(now()) @map("requested_at") @db.Timestamptz
  respondedAt  DateTime?        @map("responded_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // Self-request CHECK and the unordered-pair partial-unique index
  // (least/greatest, WHERE status IN ('pending','accepted')) are added in
  // the migration SQL — functional expression indexes aren't expressible
  // in Prisma's schema DSL.
  @@index([requesterId, status, createdAt])
  @@index([addresseeId, status, createdAt])
  @@map("friendships")
  @@schema("social")
}

model Block {
  id         String    @id @default(uuid(7)) @db.Uuid
  blockerId  String    @map("blocker_id") @db.Uuid
  blockedId  String    @map("blocked_id") @db.Uuid
  reasonCode String?   @map("reason_code")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  blocker User @relation("BlockerBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByBlocks", fields: [blockedId], references: [id], onDelete: Cascade)

  // Self-block CHECK and the partial-unique active-pair index are added
  // in the migration SQL.
  @@index([blockerId, deletedAt])
  @@index([blockedId, deletedAt])
  @@map("blocks")
  @@schema("social")
}

model UserPreference {
  userId               String    @id @map("user_id") @db.Uuid
  profileVisibility    ProfileVisibility @default(public) @map("profile_visibility")
  friendListVisible    Boolean   @default(false) @map("friend_list_visible")
  discoverable         Boolean   @default(true) @map("discoverable")
  quietHoursStart      String?   @map("quiet_hours_start") // "HH:MM", app-validated
  quietHoursEnd        String?   @map("quiet_hours_end")
  notificationDefaults Json?     @map("notification_defaults")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("social")
}

// ============================================================
// content schema — docs/04-database/database.md §6
// ============================================================

enum ContentStatus {
  published
  hidden
  removed

  @@schema("content")
}

model Post {
  id          String        @id @default(uuid(7)) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  communityId String?       @map("community_id") @db.Uuid
  body        String
  status      ContentStatus @default(published)
  visibility  String        @default("public") // public | followers | community_members | mentioned_users | private — kept as validated text, not enum, until community/mention scope exists to exercise the full set
  languageCode String       @default("en") @map("language_code")
  publishedAt DateTime?     @map("published_at") @db.Timestamptz
  editedAt    DateTime?     @map("edited_at") @db.Timestamptz
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: a post shouldn't be destroyed by a (rare, hard)
  // community deletion — it just becomes uncommunitied, same as its
  // author's account isn't touched either. Community-membership/visibility
  // *enforcement* for `community_members` posts is application-layer work,
  // out of scope for this database-only Communities increment.
  community Community?       @relation(fields: [communityId], references: [id], onDelete: SetNull)
  comments  Comment[]
  reactions PostReaction[]
  shares    Share[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([communityId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
  @@schema("content")
}

model Comment {
  id              String        @id @default(uuid(7)) @db.Uuid
  postId          String        @map("post_id") @db.Uuid
  authorId        String        @map("author_id") @db.Uuid
  parentCommentId String?       @map("parent_comment_id") @db.Uuid
  body            String
  status          ContentStatus @default(published)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz

  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Restrict)
  replies       Comment[]         @relation("CommentReplies")
  reactions     CommentReaction[]

  @@index([postId, createdAt, id])
  @@index([parentCommentId, createdAt, id])
  @@map("comments")
  @@schema("content")
}

enum ReactionType {
  like
  love
  laugh
  support
  insightful // approved five-type taxonomy, ADR-003 §8

  @@schema("content")
}

model PostReaction {
  userId       String       @map("user_id") @db.Uuid
  postId       String       @map("post_id") @db.Uuid
  reactionType ReactionType @map("reaction_type")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Plain (not partial) unique: exactly one row ever exists per
  // (user_id, post_id) — reacting again updates reaction_type/deleted_at
  // in place rather than inserting a second row (ADR-003 §6).
  @@id([userId, postId])
  @@map("post_reactions")
  @@schema("content")
}

model CommentReaction {
  userId       String       @map("user_id") @db.Uuid
  commentId    String       @map("comment_id") @db.Uuid
  reactionType ReactionType @map("reaction_type")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@map("comment_reactions")
  @@schema("content")
}

model Share {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("shares")
  @@schema("content")
}

// ============================================================
// community schema — docs/04-database/database.md §8
// (Database Phase 2, Communities module only)
// ============================================================

// PRD §24: "Communities may be public or private according to the
// approved MVP model" — a closed, already-approved 2-value set, so this
// is a real enum (unlike the fields below that stay String).
enum CommunityVisibility {
  public
  private

  @@schema("community")
}

// database.md §8 gives this exact, explicit value list (unlike
// `communities.status`/`membership_policy`/`memberships.role` below).
enum CommunityMembershipStatus {
  pending
  active
  rejected
  left
  removed
  banned

  @@schema("community")
}

model Community {
  id               String    @id @default(uuid(7)) @db.Uuid
  ownerUserId      String    @map("owner_user_id") @db.Uuid
  slug             String
  name             String
  description      String?
  visibility       CommunityVisibility @default(public)
  // Not an enum: database.md §8 names this field but never enumerates its
  // values (unlike memberships.status just below it in the same section),
  // and PRD §24/§25 don't resolve an exact policy list either — kept as
  // validated text, same treatment as `content.posts.visibility` until a
  // closed set is actually approved.
  membershipPolicy String    @default("open") @map("membership_policy")
  avatarMediaId    String?   @map("avatar_media_id") @db.Uuid // FK to media.assets added when `media` schema exists (later phase)
  coverMediaId     String?   @map("cover_media_id") @db.Uuid // FK to media.assets added when `media` schema exists (later phase)
  rules            String?
  // Not an enum, same reasoning as membershipPolicy above — database.md
  // §8 names `status` but never enumerates it for `communities` (contrast
  // `memberships.status`, which IS enumerated and IS a real enum below).
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  owner       User                  @relation("CommunityOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships CommunityMembership[]
  invitations CommunityInvitation[]
  posts       Post[]

  // Unique ACTIVE slug (WHERE deleted_at IS NULL) is a partial unique
  // index in the migration SQL, not a plain @unique here — matching the
  // Credential/UserRole/Follow/Friendship/Block active-pair pattern: a
  // hard-deleted community's slug must be reusable.
  @@index([status, visibility, createdAt(sort: Desc), id(sort: Desc)]) // discovery listing, excludes deleted via app-level status/deletedAt filter
  @@index([ownerUserId])
  @@map("communities")
  @@schema("community")
}

model CommunityMembership {
  id          String                    @id @default(uuid(7)) @db.Uuid
  communityId String                    @map("community_id") @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  status      CommunityMembershipStatus @default(pending)
  // Not an enum: PRD §25 explicitly states "the exact role names ... require
  // confirmation" beyond a minimum of owner/moderator — owner is already
  // captured by Community.ownerUserId, so this is app-validated text (e.g.
  // "member" | "moderator") until the full role matrix is approved.
  role        String                    @default("member")
  requestedAt DateTime                  @default(now()) @map("requested_at") @db.Timestamptz
  approvedAt  DateTime?                 @map("approved_at") @db.Timestamptz
  // No FK relation, matching UserRole.grantedBy's existing precedent for
  // "who performed this action" references — an unenforced plain UUID.
  approvedBy  String?                   @map("approved_by") @db.Uuid
  leftAt      DateTime?                 @map("left_at") @db.Timestamptz
  removedAt   DateTime?                 @map("removed_at") @db.Timestamptz
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique ACTIVE (community_id, user_id) — partial index (WHERE status =
  // 'active') in the migration SQL, per database.md §8's "unique active
  // (community_id, user_id)". A user may have multiple historical rows
  // (left/removed, then rejoined) but at most one active membership.
  @@index([communityId, status, createdAt, userId])
  @@index([userId, status, createdAt, communityId])
  @@map("memberships")
  @@schema("community")
}

model CommunityInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  inviterId   String    @map("inviter_id") @db.Uuid
  // Null = an open/link-based invite not yet targeted at a specific user;
  // database.md §8: "invitee or token hash" — both are supported, not
  // mutually required.
  inviteeId   String?   @map("invitee_id") @db.Uuid
  tokenHash   String    @map("token_hash") // hashed, single-use, per database.md §8
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  inviter   User      @relation("CommunityInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User?     @relation("CommunityInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  // Self-invite CHECK (inviter_id != invitee_id) is added in the migration
  // SQL, matching the Follow/Friendship/Block self-action CHECK pattern.
  @@unique([tokenHash])
  @@index([communityId, createdAt])
  @@index([inviteeId, acceptedAt, revokedAt])
  @@map("invitations")
  @@schema("community")
}

// ============================================================
// messaging schema — docs/04-database/database.md §9
// (Database Phase 2, Messaging module only — database implementation
// only; no WebSocket gateway, REST endpoints, services, or DTOs)
// ============================================================

// Mirrors content.ContentStatus's published/hidden/removed concept, but
// intentionally a separate enum (not a cross-schema reference to
// content.ContentStatus) — architecture.md principle #3: each module
// owns its business rules and persistence boundary. "active" instead of
// "published" since a message isn't "published" the way a post is.
enum MessageModerationState {
  active
  hidden
  removed

  @@schema("messaging")
}

model Conversation {
  id        String    @id @default(uuid(7)) @db.Uuid
  // CHECK-constrained to 'direct' only for as long as messaging stays
  // MVP scope (ADR-002 §7: one-to-one only; database.md §9 "Phase
  // scoping" — the column exists so group conversations don't require a
  // restructure later; widening the CHECK to add 'group' when approved
  // is a pure additive migration, not attempted here).
  kind      String    @default("direct")
  createdBy String?   @map("created_by") @db.Uuid
  title     String?
  // Not an enum: database.md §9 names this field but never enumerates
  // it. Carries the message-request pending/accepted state per
  // architecture.md §14 ("a conversation/message state ... not a
  // separate data model, so accepting a request is a state transition")
  // — default 'pending' until the application marks it accepted,
  // matching PRD §19's hold-until-accepted flow for a first message
  // from a non-connection.
  status    String    @default("pending")
  // Denormalized canonical unordered pair, 'direct' conversations ONLY
  // (NULL for any future non-direct kind) — added beyond database.md
  // §9's literal field list specifically so the database itself can
  // guarantee "at most one direct conversation per pair" via the
  // partial unique index in the migration SQL (LEAST/GREATEST, exactly
  // mirroring social.friendships' existing unordered-pair pattern)
  // instead of relying on application-level dedup logic — this turn's
  // explicit requirement. Kept in sync with `participants` by whichever
  // future application code creates the conversation.
  directParticipantAId String? @map("direct_participant_a_id") @db.Uuid
  directParticipantBId String? @map("direct_participant_b_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // SetNull: who started a conversation is metadata, not something that
  // should block a (hard, rare) user deletion or cascade-destroy the
  // conversation/messages the other participant still relies on.
  creator      User?         @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants Participant[]
  messages     Message[]

  // Restrict, matching messages.sender_id's reasoning: a direct
  // conversation's pairing identity must not silently break via an
  // unrelated hard user delete. These two relations exist so Prisma's
  // diff engine recognizes the foreign keys the messaging migration
  // already created — without them every `migrate diff` proposed
  // dropping those FKs. They are bookkeeping for the pair-uniqueness
  // index and are not traversed by application code (`participants` is
  // the real "who is in this conversation" relation). The CHECKs and the
  // LEAST/GREATEST partial unique index remain hand-added in the
  // migration SQL.
  directParticipantA User? @relation("ConversationDirectParticipantA", fields: [directParticipantAId], references: [id], onDelete: Restrict)
  directParticipantB User? @relation("ConversationDirectParticipantB", fields: [directParticipantBId], references: [id], onDelete: Restrict)

  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
  @@schema("messaging")
}

model Participant {
  conversationId    String    @map("conversation_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  // Not an enum, same reasoning as Conversation.status — database.md §9
  // names but doesn't enumerate this.
  role              String    @default("member")
  joinedAt          DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt            DateTime? @map("left_at") @db.Timestamptz
  mutedUntil        DateTime? @map("muted_until") @db.Timestamptz
  // The conversation-level read cursor database.md §9's
  // message_receipts section itself recommends preferring for scale
  // ("use conversation-level read cursors ... with per-message receipts
  // only if required") — see schema.prisma header / migration review
  // for why `messaging.message_receipts` itself is deferred.
  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  status            String    @default("active")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No FK on lastReadMessageId -> Message: would create a circular
  // cross-table dependency for a pointer field, and messages are
  // append-only/soft-deleted (never hard-removed in normal operation),
  // so integrity risk is low — matches the existing no-FK-on-"pointer"
  // precedent (identity.user_roles.granted_by, community.memberships.
  // approved_by).

  // No separate `id`/active-pair partial index needed: database.md §9
  // lists no `id` field for this table, and the composite primary key
  // below already guarantees at most one row ever exists per
  // (conversation_id, user_id) — trivially satisfying "unique active
  // (conversation_id, user_id)" since there's only ever one row, active
  // or not (unlike community.memberships, which explicitly allows
  // multiple historical rows for leave-then-rejoin).
  @@id([conversationId, userId])
  @@index([userId, status, lastReadMessageId])
  @@map("participants")
  @@schema("messaging")
}

model Message {
  id               String                 @id @default(uuid(7)) @db.Uuid
  conversationId   String                 @map("conversation_id") @db.Uuid
  senderId         String                 @map("sender_id") @db.Uuid
  // Client-supplied idempotency key so retried sends (mobile networks)
  // are safe — paired with sender_id in a unique constraint below, per
  // database.md §9. Distinct from integration.idempotency_keys (that
  // table is generic command/response caching; this is message-send-
  // specific and cheaper to check on the hot send path).
  clientMessageId String                  @map("client_message_id")
  body             String
  // Not an enum — see Conversation.status comment; database.md §9 names
  // but doesn't enumerate this. Exact send-lifecycle values are left
  // for the future messaging API to define.
  status           String                 @default("sent")
  moderationState  MessageModerationState @default(active) @map("moderation_state")
  replyToMessageId String?                @map("reply_to_message_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  editedAt         DateTime?              @map("edited_at") @db.Timestamptz
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a message belongs to BOTH participants'
  // shared history, not solely to its sender the way a Post belongs
  // solely to its author — hard-deleting the sender's user row must not
  // silently wipe the other participant's conversation history.
  // database.md §9's own 90-day deleted_at-then-purge/tombstone process
  // (ADR-003 §5) is the correct, explicit path for removing a departed
  // user's messages, not an FK-cascade side-effect.
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  // Restrict, matching Comment.parentComment's existing precedent for
  // the same self-referencing-reply shape.
  replyToMessage Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: Restrict)
  replies        Message[]    @relation("MessageReplies")

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@map("messages")
  @@schema("messaging")
}

// ============================================================
// notification schema — docs/04-database/database.md §10
// (Database Phase 2, Notifications module only — MVP is REST-polled
// in-app notifications, no WebSocket/push, ADR-004 §7)
// ============================================================

model Notification {
  id              String    @id @default(uuid(7)) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  // Null for system-originated notifications (e.g. verification,
  // moderation outcomes) that have no acting user.
  actorUserId     String?   @map("actor_user_id") @db.Uuid
  // Not an enum — see the header comment: no approved type vocabulary
  // exists to close over yet.
  type            String
  // Polymorphic reference to the thing the notification is about
  // (post, comment, conversation, community, ...) — deliberately no FK.
  // Both set or both null (CHECK in the migration SQL).
  targetType      String?   @map("target_type")
  targetId        String?   @map("target_id") @db.Uuid
  // Grouping/aggregation of repeated activity for display (PRD §20:
  // "avoid excessive duplicate notifications through grouping").
  groupKey        String?   @map("group_key")
  // Idempotency key for repeated domain events (database.md §10
  // "deduplication key") — the outbox is at-least-once, so replaying an
  // event must not create a second notification. Unique per recipient;
  // NULLs never collide, so a notification without one is unconstrained.
  // Deliberately includes soft-deleted rows: a replayed event must not
  // resurrect a notification the user already dismissed.
  dedupKey        String?   @map("dedup_key")
  // Safe display metadata only — never message bodies or other sensitive
  // content (database.md §10; architecture.md §15).
  payload         Json?
  readAt          DateTime? @map("read_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  // Cascade: a notification belongs to its recipient, and is derived/
  // rebuildable state (architecture.md principle #5) — unlike shared
  // message history, nothing else depends on it outliving the recipient.
  recipient User  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  // SetNull: who triggered it is display metadata; a hard actor deletion
  // must not delete the recipient's notification.
  actor     User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Self-notification CHECK, paired-target CHECK and the partial index for
  // unread queries are in the migration SQL (not expressible here).
  @@unique([recipientUserId, dedupKey])
  @@index([recipientUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt]) // retention/purge processing hook, same as identity.users
  @@map("notifications")
  @@schema("notification")
}

model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  // Not enums: channels and categories are both still open decisions
  // (push/email/SMS channels; no approved category list).
  category  String
  channel   String
  // No default on purpose: channels beyond in-app require consent (PRD
  // §20), so a wrong implicit "true" would be a consent bug. A row is only
  // written when the user (or the app on their behalf) makes an explicit
  // choice; absence of a row means "use the defaults in
  // social.user_preferences.notification_defaults".
  enabled   Boolean
  // Optional per-(category, channel) overrides listed in database.md
  // §10. NULL = inherit from the single source of truth
  // (social.user_preferences.quiet_hours_* / identity.users.locale) so
  // there is no duplicate authoritative copy.
  locale          String?
  quietHoursStart String?  @map("quiet_hours_start") // "HH:MM", app-validated, like social.user_preferences
  quietHoursEnd   String?  @map("quiet_hours_end")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite PK = "one row per (user_id, category, channel)"
  // (database.md §10); the table has no separate id, same as
  // content.post_reactions / messaging.participants.
  @@id([userId, category, channel])
  @@map("preferences")
  @@schema("notification")
}

// ============================================================
// integration schema — docs/04-database/database.md §15
// ============================================================

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventType     String    @map("event_type")
  eventVersion  Int       @map("event_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz

  @@index([publishedAt, availableAt, occurredAt])
  @@map("outbox_events")
  @@schema("integration")
}

model IdempotencyKey {
  ownerId           String    @map("owner_id") @db.Uuid
  key               String
  commandType       String    @map("command_type")
  requestFingerprint String   @map("request_fingerprint")
  status            String
  responsePayload   Json?     @map("response_payload")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz

  @@id([ownerId, key, commandType])
  @@map("idempotency_keys")
  @@schema("integration")
}
