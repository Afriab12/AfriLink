# Local development only — copy to .env and adjust.
# Never commit .env (already gitignored) or any real secret.
DATABASE_URL="postgresql://afrilink:replace_with_a_local_dev_password@localhost:5432/afrilink_dev"
JWT_ACCESS_SECRET="replace_with_a_long_random_local_dev_secret"
NODE_ENV=development
PORT=3000

# Media storage (docs/05-api/media.md) — local MinIO by default, dev/test only.
# Vendor-neutral: @aws-sdk/client-s3 talks to any S3-compatible endpoint the same
# way, so switching this later to a real provider is a config change, not a code
# change. Never a production vendor value here.
MEDIA_S3_ENDPOINT="http://127.0.0.1:9000"
MEDIA_S3_REGION="us-east-1"
MEDIA_S3_BUCKET="afrilink-media-dev"
MEDIA_S3_ACCESS_KEY_ID="afrilink"
MEDIA_S3_SECRET_ACCESS_KEY="replace_with_a_local_dev_password"
MEDIA_S3_FORCE_PATH_STYLE=true
