{
  "name": "@afrilink/api",
  "version": "0.1.0",
  "private": true,
  "description": "AfriLink NestJS API. Phase 1 implementation scope: authentication only.",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file=.env\"",
    "prisma:generate": "cd ../../database && npx prisma generate",
    "test": "node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env.test node_modules/vitest/vitest.mjs",
    "test:e2e": "node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@prisma/client": "file:../../database/node_modules/@prisma/client",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.0",
    "argon2": "0.45.1",
    "class-validator": "0.15.1",
    "class-transformer": "0.5.1",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@nestjs/testing": "12.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "vite": "8.3.0",
    "unplugin-swc": "1.6.0",
    "@swc/core": "1.16.2",
    "supertest": "7.2.2",
    "@types/node": "26.6.0",
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@types/supertest": "7.2.1",
    "eslint": "10.10.0",
    "typescript-eslint": "8.70.0",
    "@eslint/js": "10.0.1"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true
  }
}
